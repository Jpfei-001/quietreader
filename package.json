{
  "name": "quiet-epub-reader",
  "private": true,
  "version": "0.3.7",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/create-user-guide.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:preview": "npm run build && playwright test --config playwright.preview.config.ts",
    "demo": "node scripts/create-demo.mjs",
    "guide:build": "node scripts/create-user-guide.mjs",
    "guide:check": "node scripts/create-user-guide.mjs --check",
    "guide:screenshots": "node scripts/capture-user-guide.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:frontend": "node scripts/create-user-guide.mjs && tsc -b && vite build --mode desktop --outDir dist-desktop && node scripts/desktop-resources.mjs",
    "desktop:audit": "node scripts/desktop-resources.mjs --check",
    "release:check": "node scripts/check-release-version.mjs",
    "desktop:package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Build-Windows.ps1",
    "desktop:build": "node scripts/check-release-version.mjs && tauri build"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "epubjs": "^0.3.93",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "fake-indexeddb": "^6.2.5",
    "jszip": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11"
  }
}
